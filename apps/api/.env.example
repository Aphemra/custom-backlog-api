# The v2 API is intentionally local-only.
BACKLOG_HOST=127.0.0.1
BACKLOG_PORT=3001

# Relative paths are resolved from apps/api.
BACKLOG_DATA_DIRECTORY=./runtime

# Create these through the Twitch Developer Console for IGDB access.
# Never place the secret in frontend code or commit your real .env file.
IGDB_CLIENT_ID=your_actual_client_id
IGDB_CLIENT_SECRET=your_actual_client_secret

# Use only a dedicated disposable reader account for PlayStation access.
# The NPSSO is password-equivalent and must never belong to the target account.
PSN_READER_NPSSO=your_reader_accounts_64_character_npsso
PSN_READER_ONLINE_ID=your_reader_accounts_online_id
PSN_TARGET_ONLINE_ID=your_main_accounts_online_id